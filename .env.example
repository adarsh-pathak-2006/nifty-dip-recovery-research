# ──────────────────────────────────────────────────────────
# NIFTY Dip-Recovery Research Engine — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env and customize as needed.
# All variables have sensible defaults in config.py.
# ──────────────────────────────────────────────────────────

# Yahoo Finance ticker symbol
NIFTY_TICKER=^NSEI

# Date range for historical data
DATA_START_DATE=2005-01-01
DATA_END_DATE=2025-09-18

# Event detection threshold (e.g., -0.02 = a 2% fall)
EVENT_THRESHOLD=-0.02

# Minimum trading days between events (independence filter)
OVERLAP_COOLDOWN_DAYS=5

# Transaction cost per leg (brokerage + charges)
TRANSACTION_COST_PCT=0.0005

# Slippage per leg
SLIPPAGE_PCT=0.0005

# In-sample / out-of-sample split ratio
IN_SAMPLE_RATIO=0.70

# Bootstrap iterations for confidence intervals
BOOTSTRAP_ITERATIONS=10000
